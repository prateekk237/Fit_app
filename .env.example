# Database (Neon Postgres connection string in production)
#   postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=10
DATABASE_URL=

# Auth (openssl rand -base64 48)
JWT_SECRET=

# AI — primary + fallback chain
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Web Push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cloudflare R2 (production photo storage; leave blank for local disk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# External cron (cron-job.org Bearer token; min 16 chars)
#   openssl rand -base64 32
CRON_SECRET=

# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opt-in to in-process cron via instrumentation.ts. Vercel = leave false
# (use cron-job.org → /api/cron/* instead). Hostinger VPS = true.
FIT_ENABLE_CRON=false
